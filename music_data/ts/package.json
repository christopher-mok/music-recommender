{
  "name": "music-data",
  "version": "1.0.0",
  "description": "Read-only music data API over a published bundle (TypeScript port of music_data.api)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
