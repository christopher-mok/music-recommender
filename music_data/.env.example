# Music Data Pipeline Environment Variables
# Copy this file to .env and fill in your values. The local .env is ignored by git.

# MusicBrainz User-Agent needs a real contact address for live API requests
MUSICBRAINZ_USER_AGENT=music_data_pipeline/0.2 (your@email.example)

# ListenBrainz token is optional; needed by current popularity endpoints
LISTENBRAINZ_USER_TOKEN=

# Last.fm is optional and disabled by default
LASTFM_API_KEY=

# Database path (optional, default: data/music_metadata_100.db)
# DB_PATH=/path/to/custom/db.sqlite

# MusicBrainz User-Agent (required, must include contact info)
